<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema E-Commerce</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body>
    <nav class="navbar navbar-expand bg-dark" data-bs-theme="dark">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Sistema E-Commerce</a>
            <ul class="navbar-nav">
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Producto" asp-action="Index">Productos</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Cupon" asp-action="Index">Cupones</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Envio" asp-action="Index">Envío</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Login</a></li>
            </ul>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
